{
    "name": "denlopes/waha-laravel-sdk",
    "description": "Typed, fluent Laravel SDK for the WAHA (WhatsApp HTTP API) server.",
    "type": "library",
    "license": "MIT",
    "keywords": ["waha", "whatsapp", "laravel", "sdk"],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.5 || ^8.0",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "DenLopes\\Waha\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DenLopes\\Waha\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DenLopes\\Waha\\WahaServiceProvider"
            ],
            "aliases": {
                "Waha": "DenLopes\\Waha\\Facades\\Waha"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "pint": "vendor/bin/pint",
        "pint:test": "vendor/bin/pint --test",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
